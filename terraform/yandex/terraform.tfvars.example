cloud_id           = "b1g..."
folder_id          = "b1g..."
domain_name        = "snaphost.app"
bootstrap_key_file = "../bootstrap/key.json"

# Dashboard and public API domain. Must be a different registrable domain from
# domain_name above: browsers scope cookies, storage, and blocklist reputation
# per registrable domain, so user deploys must not share the one sessions live
# on. Empty skips the control-plane zone entirely.
control_plane_domain = ""

# Dedicated self-hosted Supabase VDS. Creates auth.<control_plane_domain> only
# when both the control-plane zone and this address are configured.
control_plane_auth_ip_address = ""

# Static public IPv4 of the edge host users point their own domains at
# (Task 16 P2). Published as an A record at edge.<domain_name>; customers CNAME
# to that hostname, and only apex domains use the address itself. Reserve it
# before accepting any external domain: if it later moves, every apex customer
# goes dark at once and only they can repair it.
edge_ip_address = ""

# Task 10.6c central router wiring.
# Build and push router-svc first:
#   cd ../../snaphost-backend
#   docker build -f router-svc/Dockerfile -t cr.yandex/<registry_id>/snaphost/router-svc:<tag> .
#   docker push cr.yandex/<registry_id>/snaphost/router-svc:<tag>
#
# Store WEBHOOK_SECRET in Yandex Lockbox outside Terraform, then pass only the
# secret identifiers below. Do not put the secret value in terraform.tfvars.
# router_user_billing_url is the durable public HTTPS API gateway/control-plane
# base URL; router appends /internal/routes. Never expose user-billing directly.
# Leave these empty to keep the API Gateway dummy 404 spec.
router_image_url                 = ""
router_user_billing_url          = ""
router_webhook_secret_id         = ""
router_webhook_secret_version_id = ""
router_webhook_secret_key        = "WEBHOOK_SECRET"
