# Use a dedicated staging-only bucket; never share a state bucket with
# production, even with different keys. Enable versioning, server-side
# encryption, public-access blocking, and TLS-only access on this bucket.
# Copy outside Git or to an ignored *.backend.hcl file and replace placeholders.
bucket = "replace-with-staging-terraform-state-bucket"
key    = "snaphost/staging/terraform.tfstate"

# Backend access key and secret are not stored here. Export staging-only
# credentials in the operator shell as AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Their identity must have no production-bucket access.
