# Safe staging template. Copy to an ignored terraform.tfvars file and replace
# every placeholder before planning. Never reuse production IDs or credentials.
cloud_id           = "replace-with-cloud-id"
folder_id          = "replace-with-staging-folder-id"
domain_name        = "staging.example.invalid"
bootstrap_key_file = "replace-with-local-staging-bootstrap-key-path.json"
environment        = "staging"

runner_sa_name               = "snaphost-staging-runner"
builder_sa_name              = "snaphost-staging-builder"
registry_name                = "snaphost-staging"
api_gateway_name             = "snaphost-staging-router"
certificate_name             = "snaphost-staging-wildcard"
router_container_name        = "snaphost-staging-router-svc"
registry_cleanup_policy_name = "snaphost-staging-cleanup"
key_output_dir               = ".keys/staging"

# Use one immutable router image SHA from the staging registry. Lockbox values
# below are identifiers only; the WEBHOOK_SECRET value must never enter tfvars.
router_image_url                 = "cr.yandex/replace-with-staging-registry-id/snaphost/router-svc:0123456789abcdef0123456789abcdef01234567"
router_user_billing_url          = "https://control.staging.example.invalid"
router_webhook_secret_id         = "replace-with-staging-lockbox-secret-id"
router_webhook_secret_version_id = "replace-with-staging-lockbox-version-id"
router_webhook_secret_key        = "WEBHOOK_SECRET"
