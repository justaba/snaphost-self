# Production Caddy edge, run by docker-compose.prod.yml.
#
# Required environment:
#   SNAPHOST_CONTROL_DOMAIN  panel/API hostname
#   SNAPHOST_ACME_EMAIL      operator's ACME account email
{
	email {$SNAPHOST_ACME_EMAIL}
	acme_ca {$SNAPHOST_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Standard Caddy ask sends GET ?domain=<SNI>. The dedicated internal
	# listener answers 2xx only when SQLite resolves a verified project-domain
	# alias to a running deploy.
	on_demand_tls {
		ask http://snaphost:8082/tls/ask
	}
}

# The control plane has a known hostname, so Caddy provisions it normally and
# never consults the on-demand gate.
{$SNAPHOST_CONTROL_DOMAIN} {
	encode zstd gzip
	reverse_proxy snaphost:8080
}

# Project domains use on-demand HTTP-01/TLS-ALPN issuance. Every request is
# resolved independently, so alias changes need no Caddy reload.
https:// {
	tls {
		on_demand
	}

	reverse_proxy snaphost:8081 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}

	log
}
