# Local development configuration.
# Copy to infra/.env, replace the two required placeholders and never commit it.

# Required. Generate a long random value.
WEBHOOK_SECRET=replace-with-a-random-secret

# Required by the current AI package at startup. Templates are used before the
# provider, but the process still validates that this key exists.
OPENROUTER_API_KEY=replace-with-an-openrouter-key

# On Linux use: stat -c %g /var/run/docker.sock
# Docker Desktop commonly exposes a root-owned socket and uses 0.
DOCKER_SOCKET_GID=0

# Application and local identity.
LOG_LEVEL=info
OPERATOR_EMAIL=operator@localhost
SESSION_TTL_HOURS=168
# Leave unset for local HTTP. Set true only behind TLS.
SESSION_COOKIE_SECURE=
CORS_ALLOW_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50

# Deploys and projects.
DEPLOY_DEFAULT_PORT=3000
DOMAIN_SUFFIX=localhost
DEPLOY_TTL_MIN=30
DEPLOY_TTL_MAX_MIN=30
CONTAINER_DEFAULT_TTL_MIN=30
ALIAS_IDLE_GC_DAYS=30
PROJECT_DEPLOY_RETENTION=3

# Custom-domain control plane. Attachment is intentionally unavailable while
# both traffic targets are empty; the portable Caddy/Docker edge is not built.
DOMAIN_CNAME_TARGET=
DOMAIN_A_RECORD_TARGET=
RESERVED_DOMAINS=
MAX_DOMAINS_PER_USER=1
DOMAIN_ATTACH_REQUIRE_IDENTITY=false
DOMAIN_ATTACH_PER_HOUR=5
DOMAIN_VERIFY_INTERVAL_SEC=60
DOMAIN_REVERIFY_HOURS=24
DOMAIN_VERIFY_GRACE_HOURS=24

# Builder.
MAX_REPO_SIZE_MB=500
MAX_BUILD_TIME_MIN=15
MAX_CONCURRENT_PER_USER=3
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
ALLOWED_BASE_IMAGES=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:
ALLOWED_BASE_IMAGES_PERMISSIVE=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:,rust:,php:,openjdk:,eclipse-temurin:,mcr.microsoft.com/dotnet/,httpd:,redis:,postgres:,mysql:,mariadb:,mongo:
# Docker runtime.
RUNNER_BACKEND=docker
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEMORY_MB=512
RUNTIME_PROBE_ENABLED=true
RUNTIME_PROBE_TIMEOUT_SEC=30
WATCHDOG_INTERVAL_SEC=30
STRICT_IMAGE_VALIDATION=false
ALLOWED_IMAGE_PREFIXES=snaphost/

# Control-plane cgroup. The process derives GOMEMLIMIT from this limit and
# reserves memory for page cache and other non-heap allocations.
CONTROL_PLANE_MEMORY_LIMIT=512M
GOMEMLIMIT_RESERVE_MB=

# AI fallback.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=snaphost-self
LLM_TIMEOUT=30s
CACHE_TTL_DAYS=7
