# Copy this file to .env and fill in real values. Never commit .env to git.
POSTGRES_DB=snaphost
POSTGRES_USER=snaphost
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
API_GATEWAY_PORT=8080
BUILDER_SVC_PORT=8082
RUNNER_SVC_PORT=8082
DOMAIN=localhost
# api-gateway prefetches JWKS from ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# at startup and exits fatally if that host is unreachable.
#
# Local development with the Supabase CLI: http://host.docker.internal:54321
# Do NOT use the kong container name (http://supabase_kong_<project>:8000) — the
# CLI puts kong on its own Docker network, so a compose service would only reach
# it after a manual `docker network connect`, and that wiring is lost every time
# `supabase stop` recreates the container.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-here
INITIAL_VIBECOIN_BALANCE=100
WEBHOOK_SECRET=your-internal-webhook-secret-here
USER_BILLING_PORT=8083

# CORS — comma-separated allowed origins (leave empty in production)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Builder service
REGISTRY_URL=registry:5000/snaphost
REGISTRY_AUTH_MODE=static
# REGISTRY_INSECURE controls whether Trivy disables TLS verification when
# pulling images for scanning. Default: false (secure).
#
# Auto-enabled when REGISTRY_URL points at localhost, 127.0.0.1,
# host.docker.internal, or registry: (local dev). For production with TLS
# registries (cr.yandex etc.) leave unset or false.
#
# Setting this to true with a non-local registry emits a warning.
# REGISTRY_INSECURE=false
# Yandex production registry contract:
# REGISTRY_URL=cr.yandex/<registry_id>/snaphost
# REGISTRY_AUTH_MODE=yandex_iam
# YANDEX_SA_KEY_PATH=/secrets/builder-key.json
# REGISTRY_INSECURE=false
# SCAN_FAIL_ON_CRITICAL=true
BUILDKIT_HOST=tcp://buildkitd:1234
MAX_REPO_SIZE_MB=500
MAX_BUILD_TIME_MIN=15
MAX_CONCURRENT_PER_USER=3
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Comma-separated list of allowed Docker base image prefixes. Used by both
# builder-svc (Dockerfile validator) and ai-orchestrator (LLM constraint).
# When extending: add prefix WITH trailing colon (e.g. "rust:") or slash for
# registry paths (e.g. "gcr.io/distroless/"). Match is case-insensitive prefix.
ALLOWED_BASE_IMAGES=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:

# Permissive base image allow-list for USER-PROVIDED Dockerfiles. Wider
# than ALLOWED_BASE_IMAGES (which constrains LLM generation). Same prefix
# format. When a user ships their own Dockerfile, this list applies; LLM
# generation continues to use the strict ALLOWED_BASE_IMAGES.
ALLOWED_BASE_IMAGES_PERMISSIVE=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:,rust:,php:,openjdk:,eclipse-temurin:,mcr.microsoft.com/dotnet/,httpd:,redis:,postgres:,mysql:,mariadb:,mongo:

# Runner service
RUNNER_BACKEND=docker
DOMAIN_SUFFIX=localhost
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEMORY_MB=512
# Local dev keeps a short TTL on purpose: here a container really does hold
# host RAM for its whole TTL, which is what the 30-minute default was sized
# for. Production uses 24h (see .env.production.example).
CONTAINER_DEFAULT_TTL_MIN=30
# Per-deploy TTL user-billing sends to runner-svc, and the ceiling it
# enforces. Kept at the local container TTL so dev behaviour is unchanged.
DEPLOY_TTL_MIN=30
DEPLOY_TTL_MAX_MIN=30
WATCHDOG_INTERVAL_SEC=30
REGISTRY_AUTH=

# Liveness probe (Task 15b). A deploy is reported running only once something
# answers on the port the runtime injects; otherwise it is torn down, marked
# failed with a reason, and the coin reservation is refunded. Disabling this
# restores the old meaning of "running" — started, not serving.
RUNTIME_PROBE_ENABLED=true
RUNTIME_PROBE_TIMEOUT_SEC=30

# Custom domains (Task 16). Empty locally on purpose: attach then refuses with
# edge_address_unreserved, which is the path worth exercising in dev. The real
# reserved address lives in docs/operations/public-address.md and is set in the
# production env.
DOMAIN_CNAME_TARGET=
DOMAIN_A_RECORD_TARGET=
# Zones users may never attach, in addition to DOMAIN_SUFFIX. In production this
# holds the control-plane domain (snaphost.ru); locally there is nothing to
# protect, so it is empty.
RESERVED_DOMAINS=
MAX_DOMAINS_PER_USER=1
DOMAIN_ATTACH_REQUIRE_IDENTITY=false
DOMAIN_ATTACH_PER_HOUR=5
DOMAIN_VERIFY_INTERVAL_SEC=60
DOMAIN_REVERIFY_HOURS=24
ALIAS_IDLE_GC_DAYS=30
PROJECT_DEPLOY_RETENTION=3

# Image validation (runner-svc)
# Set STRICT_IMAGE_VALIDATION=true in prod; false locally for faster iteration without user-billing roundtrip.
# When STRICT_IMAGE_VALIDATION=true, REGISTRY_ALLOWED_PREFIXES MUST be set — runner-svc fails at startup otherwise.
STRICT_IMAGE_VALIDATION=false
REGISTRY_ALLOWED_PREFIXES=host.docker.internal:5000/snaphost,registry:5000/snaphost
# Yandex production runner contract:
# RUNNER_BACKEND=yandex
# YANDEX_REGISTRY_URL=cr.yandex/<registry_id>/snaphost
# REGISTRY_ALLOWED_PREFIXES=cr.yandex/<registry_id>/snaphost
# STRICT_IMAGE_VALIDATION=true
# REGISTRY_AUTH_MODE=yandex_iam
# REGISTRY_INSECURE=false
# SCAN_FAIL_ON_CRITICAL=true

# AI Orchestrator — powered by OpenRouter (https://openrouter.ai)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Model identifier in "vendor/model" format. Examples:
#   openai/gpt-4o-mini          — fast and cheap, recommended for Dockerfile generation
#   anthropic/claude-3.5-sonnet — best quality, more expensive
#   meta-llama/llama-3.3-70b-instruct — open source
#   deepseek/deepseek-chat      — very cheap
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — helps with OpenRouter analytics and free-tier limits.
OPENROUTER_REFERER=https://snaphost.app
OPENROUTER_APP_NAME=SnapHost
