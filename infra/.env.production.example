# Image contract: use a 40-character Git commit SHA, never "latest".
SNAPHOST_VERSION=0123456789abcdef0123456789abcdef01234567
GHCR_IMAGE_PREFIX=ghcr.io/example-org/example-repository

# Public API listener. Put TLS/reverse-proxy policy outside this Phase 1 manifest.
SNAPHOST_BIND_ADDRESS=0.0.0.0
SNAPHOST_PORT=8080
# Two registrable domains on purpose (see docs/architecture/deployment-model.md):
# user deploys answer under DOMAIN_SUFFIX, while the dashboard and API live on
# the control-plane domain. Cookies, storage, and blocklist reputation are all
# scoped per registrable domain, so user content must not share ours.
DOMAIN_SUFFIX=snaphost.pw

# The store is one SQLite file in the application's own volume, so there is no
# database service, no credentials, and no connection string. Its path is fixed
# in the Compose file rather than configured here: it names a mount point
# inside the container, which an operator has no reason to move.

# Identity. Nothing external is contacted: on first start the operator account
# is created and its password written once to the container log. Read it there
# and change it; it is not recoverable afterwards.
OPERATOR_EMAIL=operator@localhost
SESSION_TTL_HOURS=168
# Production terminates TLS, so the session cookie insists on it. Only turn
# this off for a box being reached over plain HTTP.
SESSION_COOKIE_SECURE=true

# The dashboard's own origin — the control-plane domain, never a deploy host.
CORS_ALLOW_ORIGINS=https://snaphost.ru

# API policy.
# The application never migrates on startup in production; deploy.sh runs the
# profile-only migrate service before the rollout, so a schema change fails
# before anything is serving traffic rather than during. This matters more on
# SQLite than it did on PostgreSQL: the migrator and the application are two
# containers holding one file, and only `compose run --rm` finishing keeps
# them from overlapping.
RUN_MIGRATIONS=false
SAGA_BUILD_TIMEOUT_MIN=15
SAGA_RESUME_INTERVAL_SEC=60
DEPLOY_DEFAULT_PORT=3000
LOG_LEVEL=info

# Builder and BuildKit.
# There is no registry. A build and the container that runs it share a host,
# so BuildKit exports the image into the local Docker daemon and the runtime
# starts it from there. Nothing is pushed, and no credential is needed.
MAX_REPO_SIZE_MB=500
MAX_BUILD_TIME_MIN=15
MAX_CONCURRENT_PER_USER=3
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
ALLOWED_BASE_IMAGES=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:
ALLOWED_BASE_IMAGES_PERMISSIVE=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:,rust:,php:,openjdk:,eclipse-temurin:,mcr.microsoft.com/dotnet/,httpd:,redis:,postgres:,mysql:,mariadb:,mongo:

# Runner. User containers run on this host's own Docker daemon, so there are
# no cloud credentials here any more — the runner mounts the daemon socket
# instead, which is a larger privilege than the service account it replaced.
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEMORY_MB=512
# Free-tier preview TTL is 24 hours (Task 16a item 9). On Serverless
# Containers an idle deploy scales to zero and costs approximately nothing,
# and a link that survives the working day is the difference between a
# shareable preview and one that expires before anyone opens it. This is the
# runtime fallback; the control saga sends the configured TTL per deploy.
CONTAINER_DEFAULT_TTL_MIN=1440
WATCHDOG_INTERVAL_SEC=30
STRICT_IMAGE_VALIDATION=true
# The builder names every image it produces "snaphost/proj-<hash>:<deploy>", so
# this prefix covers everything the platform itself starts. Anything else on
# the daemon is refused, which is the point of the strict mode above.
ALLOWED_IMAGE_PREFIXES=snaphost/

# Liveness probe (Task 15b). Must stay on in production: without it a deploy
# whose server ignores PORT is reported running and billed while every request
# fails. The timeout has to outlast a scale-to-zero cold start.
RUNTIME_PROBE_ENABLED=true
RUNTIME_PROBE_TIMEOUT_SEC=45

# Per-deploy TTL sent by control, and the ceiling it enforces. Runtime
# applies any non-zero ttl_minutes with no upper bound, so the tier limit is
# applied where the tier is known.
DEPLOY_TTL_MIN=1440
DEPLOY_TTL_MAX_MIN=1440

# Custom domains (Task 16). These are the reserved public address from
# docs/operations/public-address.md — a contract other people's DNS zones
# depend on, not a config knob. Changing DOMAIN_A_RECORD_TARGET takes every
# apex-domain customer down until they edit their own zone.
DOMAIN_CNAME_TARGET=edge.snaphost.pw
DOMAIN_A_RECORD_TARGET=135.106.166.76
# Zones users may never attach. DOMAIN_SUFFIX is refused automatically; this
# adds the control-plane domain, which is a different registrable domain from
# user deploys on purpose — a deployed app must not be able to set cookies on
# the domain the dashboard authenticates against.
RESERVED_DOMAINS=snaphost.ru,snaphost.online
MAX_DOMAINS_PER_USER=1
# Abuse gate, not a price gate: free custom domains attract phishing and the
# cost lands on the reputation of our edge address. Turn on once an identity
# signal (verified payment method) exists; until then attach relies on the
# rate limit plus manual review.
DOMAIN_ATTACH_REQUIRE_IDENTITY=false
DOMAIN_ATTACH_PER_HOUR=5
DOMAIN_VERIFY_INTERVAL_SEC=60
DOMAIN_REVERIFY_HOURS=24
# How long a newly attached domain may go without its TXT record before that
# counts as a failure rather than as DNS still propagating. Inside the window
# the domain stays "pending" — telling someone verification failed two minutes
# after they attached makes a working setup look broken.
DOMAIN_VERIFY_GRACE_HOURS=24
# Alias-pinned deploys are exempt from TTL; superseded deploys are kept per
# project as rollback targets.
PROJECT_DEPLOY_RETENTION=3

# Dockerfile generation fallback.
# OpenAI-compatible endpoint the LLM client talks to. The provider is
# configuration, not code: OpenRouter, OpenAI, and Anthropic all refuse
# requests from Russia, so moving must not require a release.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ask the provider to constrain output to a JSON object. `response_format` is
# an OpenAI extension — a gateway fronting a vendor without an equivalent may
# reject it. Turning it off costs only a guarantee: the prompt already demands
# JSON and the response is parsed defensively.
LLM_JSON_MODE=true
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=https://snaphost.example.com
OPENROUTER_APP_NAME=SnapHost
LLM_TIMEOUT=30s

# Compose resource ceilings; tune after observing the production VDS. The
# PostgreSQL and Redis pairs are gone with their services: 2 CPUs and 2G were
# reserved for a database that idled at 25.7 MiB and is now a file, and 1 CPU
# and 1G for a broker between goroutines in one process.
SNAPHOST_CPU_LIMIT=1.0
# This is the only place the application's memory ceiling is written: the
# process reads its own cgroup at startup and derives GOMEMLIMIT from it, minus
# a reserve for what the Go heap does not cover.
#
# With image scanning removed, 512M leaves roughly 384M for the Go heap after
# the default 128M reserve. Increase this after measurement if large archives
# or concurrent builds create sustained memory pressure.
SNAPHOST_MEMORY_LIMIT=512M
BUILDKIT_CPU_LIMIT=4.0
BUILDKIT_MEMORY_LIMIT=4G

# deploy.sh settings are operator shell variables, not Compose secrets. Example:
# SNAPHOST_PUBLIC_SMOKE_URL=https://control.example.invalid
# SNAPHOST_COMPOSE_PROJECT=snaphost-production
# SNAPHOST_STATE_DIR=/opt/snaphost/state
# SNAPHOST_BACKUP_DIR=/opt/snaphost/backups
# SNAPHOST_GHCR_TOKEN_FILE=/opt/snaphost/secrets/ghcr-token
# MIGRATIONS_BACKWARD_COMPATIBLE=false

# --- Custom-domain edge (ADR 0007) ---------------------------------------
# The cloud router is gone: user containers now run on this
# host's own Docker daemon, so Traefik routes them directly by Host and there
# is nothing between Caddy and the container to configure here.
#
# The edge itself is still to be built (Task 4): one Caddy terminating TLS for
# both the panel and every attached domain, driven by the control binary. The
# inherited on-demand issuance and TXT verification carry over unchanged.
