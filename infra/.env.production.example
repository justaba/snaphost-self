# snaphost-self — production environment
#
# `snaphostctl install` copies this file and fills the required section. For an
# advanced manual setup, copy it yourself, edit these three variables, and keep
# it at mode 0600. `deploy.sh preflight` refuses a file that is world- or
# group-readable, and refuses one that still contains a `replace-with-`
# placeholder, so an unedited copy cannot be deployed by accident.
#
# Everything below the first section is optional. Each of those variables has a
# default in the application, and leaving a line out means "use that default" —
# an unset variable reaches the process as an empty string, which every config
# reader treats as unset. They are listed here because they are the ones worth
# an operator's attention, not because they must be set.
#
# The full set of variables the application understands is larger than this
# file. If a knob you need is missing, add the line: nothing validates this
# file against a list, on purpose.

# ---------------------------------------------------------------------------
# Required.
# ---------------------------------------------------------------------------

# The published version to run — a tag, never a moving one. `latest` is never
# published, and the manifest refuses a floating tag, so this is always an
# exact release. `deploy.sh deploy <version>` rewrites this line atomically
# after the new release has passed readiness and smoke checks.
SNAPHOST_VERSION=replace-with-version-tag

# Caddy owns ports 80/443 and serves the panel/API at this hostname.
SNAPHOST_CONTROL_DOMAIN=replace-with-control-domain

# Account contact used for Caddy's ACME certificate management.
SNAPHOST_ACME_EMAIL=replace-with-acme-email

# Optional AI Dockerfile generation. With this disabled, use your own
# Dockerfile or a built-in template; unsupported projects ask for a Dockerfile.
# A stored API key alone does not enable AI. Set both values to opt in.
# LLM_ENABLED=false
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional — exposure and identity
# ---------------------------------------------------------------------------

# Where the application's recovery port is published. Caddy normally serves
# the panel, so this stays on host loopback. snaphostctl changes it to 0.0.0.0
# only for the explicit short-lived HTTP evaluation mode.
# SNAPHOST_BIND_ADDRESS=127.0.0.1
# SNAPHOST_PORT=8080

# Caddy's persistent certificate/account state. snaphostctl sets this to the
# protected state directory of the installation.
# SNAPHOST_CADDY_STATE_DIR=/opt/snaphost/state/caddy
# For staging rehearsal only, set this to the Let's Encrypt staging directory
# and use a separate Caddy state directory. Switch both back for production.
# SNAPHOST_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Derived by snaphostctl from /var/run/docker.sock. It is not an operator
# decision, but the non-root application container cannot use Docker without
# joining this numeric group.
# DOCKER_SOCKET_GID=0

# The operator account, created on first start with a password written once to
# the container log. Read it there; it is not recoverable afterwards, and
# changing this line later does not rename the account.
# OPERATOR_EMAIL=operator@localhost
# SESSION_TTL_HOURS=168

# The session cookie insists on HTTPS by default. Turn it off only while
# reaching a box over plain HTTP, or the browser will not return the cookie.
# SESSION_COOKIE_SECURE=true

# The panel is served by this same process, so cross-origin callers are the
# exception. Set it to the control-plane origin only if something else needs it.
# CORS_ALLOW_ORIGINS=

# Hostnames nobody may attach as a project domain. The installer adds the
# control-plane domain automatically.
# RESERVED_DOMAINS=

# Zero removes the global user quota, allowing every project to have its own
# domain. Set a positive value only when this installation needs a cap.
# MAX_DOMAINS_PER_USER=0

# What an attached custom domain is told to point DNS at — CNAME for
# subdomains, A for an apex. While both are empty the application refuses an
# attach, because it has no address to hand out. The routing adapters exist,
# and Compose now runs Caddy; public DNS is still operator-managed. See
# docs/operations/custom-domains.md.
# DOMAIN_CNAME_TARGET=
# DOMAIN_A_RECORD_TARGET=

# ---------------------------------------------------------------------------
# Optional — what the host spends on itself and on the sites it hosts
# ---------------------------------------------------------------------------

# The control plane's own ceiling. The process reads this cgroup limit at
# startup and derives GOMEMLIMIT from it, holding back a reserve for page cache
# and non-heap memory, so this is the only place the number is written.
# SNAPHOST_MEMORY_LIMIT=512M
# SNAPHOST_CPU_LIMIT=1.0

# Builds are the memory spike on this box. BuildKit is where a Node install
# lands. snaphostctl pins its CPU limit to the smaller of four CPUs and the host
# capacity, and its memory limit to half of host RAM (rounded down to 64 MiB,
# capped at 4 GiB). This leaves headroom for the panel, sites and OS. A manually
# configured memory value is preserved; size it from actual build measurements.
# BUILDKIT_MEMORY_LIMIT=4G
# BUILDKIT_CPU_LIMIT=4.0

# Per-site limits, applied to every user container.
# CONTAINER_MEMORY_MB=512
# CONTAINER_CPU_LIMIT=0.5

# How long a deploy lives before the watchdog stops it, and how long a stopped
# deploy keeps the image that makes starting it again a container run rather
# than a rebuild.
# CONTAINER_DEFAULT_TTL_MIN=1440
# DEPLOY_TTL_MIN=1440
# STOPPED_IMAGE_GRACE_HOURS=168
# PROJECT_DEPLOY_RETENTION=10

# ---------------------------------------------------------------------------
# Optional — build inputs
# ---------------------------------------------------------------------------

# Where a repository may be cloned from, and what a Dockerfile may build FROM.
# The permissive list applies to Dockerfiles an operator wrote; the strict one
# to Dockerfiles this platform generated. Untagged and `latest` bases are
# refused by both.
# ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# ALLOWED_BASE_IMAGES=node:,python:,golang:,ruby:,nginx:,alpine:,debian:,ubuntu:,gcr.io/distroless/,oven/bun:,denoland/deno:

# MAX_REPO_SIZE_MB=500
# MAX_BUILD_TIME_MIN=15
# MAX_UPLOAD_SIZE_MB=50

# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional — release plumbing
# ---------------------------------------------------------------------------

# The public package this install pulls from. Override only to run a fork.
# GHCR_IMAGE_PREFIX=ghcr.io/justaba/snaphost-self

# A public URL for `deploy.sh` to check after the rollout. Unset means the
# deploy still runs its internal readiness and restart-loop checks and says out
# loud that it skipped the public one — which is the right answer for a host
# that does not have a public address yet.
# SNAPHOST_PUBLIC_SMOKE_URL=
