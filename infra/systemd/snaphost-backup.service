[Unit]
Description=SnapHost scheduled SQLite backup
Documentation=https://github.com/justaba/snaphost-self/blob/main/docs/operations/backups.md
# The backup runs sqlite3 inside the application container through Docker, so
# there is nothing to back up before Docker is up.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Host integration is installed and operated by root. The application itself
# still runs as a fixed non-root identity inside its container; this unit needs
# the root-equivalent Docker socket in order to run sqlite3 there.
User=root
Group=root
WorkingDirectory=/opt/snaphost

# Everything the script needs that is not a secret. Credentials for the
# off-host copy live in the referenced environment file, mode 0600, owned by
# root — it is read by systemd, not by the shell, so it never lands
# in a process argument list.
EnvironmentFile=-/opt/snaphost/env/backup.env

# ProtectHome=true hides $HOME, and the Docker CLI refuses to execute its
# plugins when it cannot reach its config directory. Point the config somewhere
# the sandbox can write instead of opening up the home directory.
Environment=DOCKER_CONFIG=/opt/snaphost/state/.docker

# Operator-managed stable tag checkout. snaphostctl refreshes this unit when
# backup.sh moves with an upgrade or rollback.
# WorkingDirectory above is load-bearing — `docker compose` stats its working
# directory, and an unreadable checkout fails the whole run.
ExecStart=/opt/snaphost/infra/backup.sh run

# A backup that takes longer than this is stuck rather than slow; the dump of
# a control-plane database is minutes, not hours.
TimeoutStartSec=3600

# The lock is shared with deploy.sh and a scheduled run yields to a deployment,
# so a retry is only useful for transient Docker/network failures.
Restart=on-failure
RestartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The Docker socket must be writable: ProtectSystem=strict mounts the whole
# hierarchy read-only, and connecting to a unix socket needs write permission.
# Without this `compose ps` cannot reach the daemon, so it looks like there is
# no application container.
ReadWritePaths=/opt/snaphost/backups /opt/snaphost/state /run/docker.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
