FROM node:{{NODE_VERSION}}-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./
# A strict install is the right default: it installs exactly what the lock
# file pins. It also fails outright when that file has drifted from
# package.json, which is common in a repository nobody has installed in for a
# while — and whoever is deploying it usually cannot fix the repository. So a
# strict failure falls back to a resolving install, saying so in the log,
# rather than ending the deploy.
#
# The lock file is also tested before npm ci runs. That command refuses to do
# anything without one, so a project carrying only a package.json could not be
# built at all.
RUN \
  if [ -f pnpm-lock.yaml ]; then \
    npm install -g pnpm && \
    { pnpm install --frozen-lockfile || { echo "snaphost: pnpm-lock.yaml is out of sync with package.json; installing without it" >&2; pnpm install --no-frozen-lockfile; }; }; \
  elif [ -f yarn.lock ]; then \
    yarn install --frozen-lockfile || { echo "snaphost: yarn.lock is out of sync with package.json; installing without it" >&2; yarn install; }; \
  elif [ -f package-lock.json ]; then \
    npm ci || { echo "snaphost: package-lock.json is out of sync with package.json; installing without it" >&2; npm install; }; \
  else \
    npm install; \
  fi
COPY . .
RUN {{BUILD_CMD}}
# Angular CLI outputs to dist/<project>/ (v16-) or dist/<project>/browser/ (v17+).
# Resolve dynamically so the runtime stage doesn't have to know.
RUN set -e; \
    INDEX_HTML=$(find dist -type f -name index.html -print -quit); \
    if [ -z "$INDEX_HTML" ]; then echo "ERROR: index.html not found under dist/" >&2; exit 1; fi; \
    OUTPUT_DIR=$(dirname "$INDEX_HTML"); \
    mkdir -p /app/build-output; \
    cp -a "$OUTPUT_DIR/." /app/build-output/

FROM nginx:alpine
COPY --from=builder /app/build-output /usr/share/nginx/html
# The server config is written at build time, into its final location.
#
# nginx ships an entrypoint that renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d at startup. The runtime starts every user container with a
# read-only root filesystem, so that render fails on its first write and takes
# the container down before nginx ever runs.
#
# The port is a literal rather than ${PORT} for the same reason it can be: no
# PORT is injected into a user container. The runtime reads EXPOSE and probes
# that, so there was never a runtime value for envsubst to substitute.
ENV PORT=8080
RUN printf '%s\n' \
  'server {' \
  '  listen 8080;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '}' \
  > /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
