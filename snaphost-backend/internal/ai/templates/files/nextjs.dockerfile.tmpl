# syntax=docker/dockerfile:1.7
FROM node:{{NODE_VERSION}}-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./
# A strict install is the right default: it installs exactly what the lock
# file pins. It also fails outright when that file has drifted from
# package.json, which is common in a repository nobody has installed in for a
# while — and whoever is deploying it usually cannot fix the repository. So a
# strict failure falls back to a resolving install, saying so in the log,
# rather than ending the deploy.
#
# The lock file is also tested before npm ci runs. That command refuses to do
# anything without one, so a project carrying only a package.json could not be
# built at all.
RUN \
  if [ -f pnpm-lock.yaml ]; then \
    npm install -g pnpm && \
    { pnpm install --frozen-lockfile || { echo "snaphost: pnpm-lock.yaml is out of sync with package.json; installing without it" >&2; pnpm install --no-frozen-lockfile; }; }; \
  elif [ -f yarn.lock ]; then \
    yarn install --frozen-lockfile || { echo "snaphost: yarn.lock is out of sync with package.json; installing without it" >&2; yarn install; }; \
  elif [ -f package-lock.json ]; then \
    npm ci || { echo "snaphost: package-lock.json is out of sync with package.json; installing without it" >&2; npm install; }; \
  else \
    npm install; \
  fi

FROM node:{{NODE_VERSION}}-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN {{BUILD_CMD}}

FROM node:{{NODE_VERSION}}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
USER nextjs
EXPOSE 3000
CMD ["{{START_CMD}}"]
