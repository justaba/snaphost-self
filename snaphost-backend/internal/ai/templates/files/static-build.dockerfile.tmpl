FROM node:{{NODE_VERSION}}-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then npm install -g pnpm && pnpm install --frozen-lockfile; \
  elif [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  else npm install; \
  fi
COPY . .
RUN {{BUILD_CMD}}
# Bundlers disagree about where a build lands, and the ones this template is
# for — rollup, parcel, webpack, esbuild and friends — are configured per
# project rather than by convention. The candidates are tried in order, and the
# first one holding an index.html wins: dist and build are the common outputs,
# public is where rollup and Svelte projects usually write, out belongs to
# static exports, _site to site generators.
#
# Failing here, loudly, is the point. A project that builds a server rather
# than a page produces no index.html anywhere, and saying so beats shipping an
# empty nginx that answers 404 to everything.
RUN set -e; \
    OUTPUT_DIR=""; \
    for candidate in dist build public out _site .output/public; do \
      if [ -f "$candidate/index.html" ]; then OUTPUT_DIR="$candidate"; break; fi; \
    done; \
    if [ -z "$OUTPUT_DIR" ]; then \
      echo "ERROR: no index.html in dist/, build/, public/, out/, _site/ or .output/public/ after the build" >&2; \
      echo "This project may not produce a static site. Add a Dockerfile to the repository." >&2; \
      exit 1; \
    fi; \
    mkdir -p /app/build-output; \
    cp -a "$OUTPUT_DIR/." /app/build-output/

FROM nginx:alpine
COPY --from=builder /app/build-output /usr/share/nginx/html
# The server config is written at build time, into its final location.
#
# nginx ships an entrypoint that renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d at startup. The runtime starts every user container with a
# read-only root filesystem, so that render fails on its first write and takes
# the container down before nginx ever runs.
#
# The port is a literal rather than ${PORT} for the same reason it can be: no
# PORT is injected into a user container. The runtime reads EXPOSE and probes
# that, so there was never a runtime value for envsubst to substitute.
ENV PORT=8080
RUN printf '%s\n' \
  'server {' \
  '  listen 8080;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '}' \
  > /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
