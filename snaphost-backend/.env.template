# Local Supabase PostgreSQL Database Connection
# This points to the database instance running via "npx supabase start"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# CORS — allowed origins for local frontend development (comma-separated).
# Leave empty to disable CORS headers (production default).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
