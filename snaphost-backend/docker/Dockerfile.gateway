# Build context is snaphost-backend/ — the module root. Every service builds
# from there now that the six modules are one (Task 1 item 4).
FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags='-s -w' -o /out/api-gateway ./cmd/gateway

FROM gcr.io/distroless/static-debian12

WORKDIR /
COPY --from=builder /out/api-gateway /api-gateway
COPY internal/gateway/rbac_model.conf /rbac_model.conf
COPY internal/gateway/rbac_policy.csv /rbac_policy.csv

EXPOSE 8080
USER nonroot:nonroot

ENTRYPOINT ["/api-gateway"]
