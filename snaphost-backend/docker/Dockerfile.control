# syntax=docker/dockerfile:1

# Build context is snaphost-backend/ — the module root. Every service builds
# from there now that the six modules are one (Task 1 item 4).

# ---------------------------------------------------------------------------
# Stage 1: Build
# ---------------------------------------------------------------------------
FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags='-s -w' -o /out/user-billing ./cmd/control && \
    CGO_ENABLED=0 go build -ldflags='-s -w' -o /out/migrate ./cmd/control-migrate

# ---------------------------------------------------------------------------
# Stage 2: Runtime (distroless — minimal attack surface)
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12

COPY --from=builder /out/user-billing /user-billing
COPY --from=builder /out/migrate /migrate

EXPOSE 8081

USER nonroot:nonroot

ENTRYPOINT ["/user-billing"]
