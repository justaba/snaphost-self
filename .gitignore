.env
secrets/
bin/
dist/
*.exe
node_modules/
.gocache/
.tmp-*/
*.tsbuildinfo

# Runtime state created when the supported checkout lives at /opt/snaphost.
/env/
/state/
/backups/

# Docker artifacts
docker-compose.override.yml
.docker/

# IDE files
.idea/
.vscode/
.claude/settings.local.json
*.swp

# OS files
.DS_Store
Thumbs.db

# Test coverage
*.out
coverage/

# Terraform local state, credentials, plans, and generated runtime keys
**/.terraform/
*.tfstate
*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/*.auto.tfvars
**/*.backend.hcl
!**/*.backend.hcl.example
**/.keys/
*.tfplan
*.tfplan.*
*.plan
terraform/bootstrap/
terraform/outputs.json

# Task 16c acceptance test: a throwaway DNS zone standing in for a customer.
# Not platform infrastructure, keeps its own local state.
terraform/.test-customer-domain/

# Local tooling caches from existing developer checkouts
.tools/

# The panel's build output. It is embedded into the binary and produced by the
# image build, so it is not committed — but the directory has to exist for
# go:embed to compile, which is what the .gitkeep is for.
snaphost-backend/internal/panel/dist/*
!snaphost-backend/internal/panel/dist/.gitkeep
